# Copia este archivo como "env" y completa los valores reales.
# NUNCA subas el archivo "env" al repositorio.

# --- BASE DE DATOS (Aiven MySQL) ---
SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/defaultdb?useSSL=true&allowPublicKeyRetrieval=true&enabledTLSProtocols=TLSv1.2,TLSv1.3
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=<tu_password_de_aiven>

# --- INTELIGENCIA ARTIFICIAL ---
# Obtén tu API Key gratis en: https://aistudio.google.com/app/apikey
GOOGLE_AI_GEMINI_API_KEY=<tu_api_key_de_gemini>
